# StudySlot server environment variables.
# Copy this file to .env (same folder) and replace the placeholder values.
# .env is ignored by Git. NEVER commit real values or paste them anywhere public.

# Port the API listens on locally. Render sets its own PORT in production.
PORT=5000

# development | production | test
NODE_ENV=development

# MongoDB Atlas connection string for the app's database user (studyslot_app).
# Include the database name after ".net/".
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER-HOST/appointment_platform?retryWrites=true&w=majority

# Secret used to sign login tokens. At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# How long a login lasts before the user must sign in again (e.g. 1d, 12h).
JWT_EXPIRES_IN=1d

# The exact origin of the React app, allowed by CORS. No trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# AI recommendation feature. Optional: without a key and model, the endpoint
# uses its non-AI keyword fallback.
# AI_PROVIDER: groq (recommended: fast, 1,000 free requests/day per model) or openrouter.
# AI_MODEL must support strict structured outputs, e.g. openai/gpt-oss-20b on Groq.
AI_PROVIDER=groq
AI_MODEL=replace-with-model-id
AI_API_KEY=replace-with-provider-key
