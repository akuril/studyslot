{
  "name": "studyslot-server",
  "version": "1.0.0",
  "private": true,
  "description": "StudySlot REST API (Node.js, Express, MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "check:models": "node --env-file-if-exists=.env scripts/checkModels.js",
    "seed": "node --env-file-if-exists=.env scripts/seedServices.js",
    "test": "node --test tests/*.test.js",
    "cleanup:test-data": "node --env-file-if-exists=.env scripts/cleanupTestData.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2"
  }
}
