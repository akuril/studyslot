# StudySlot client environment variables.
# Copy this file to .env (same folder) for local development.
#
# IMPORTANT: every VITE_ variable is built into the public JavaScript bundle.
# Anyone can read it in the browser. NEVER put secrets here.

# Base URL of the StudySlot API, including /api. No trailing slash.
# Local development: "/api" goes through the Vite dev proxy (vite.config.js),
# so the browser only talks to http://localhost:5173.
# Netlify: set the full Render URL, e.g. https://<your-api>.onrender.com/api
VITE_API_BASE_URL=/api
