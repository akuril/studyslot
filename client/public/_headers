# Security headers for the StudySlot web app on Netlify (Netlify reads this file from
# the published folder; Vite copies everything in client/public/ into dist/).
#
# Content-Security-Policy: the browser only runs code and loads data from places listed
# here, which limits the damage any injected script could do (the login token lives in
# localStorage). connect-src allows the API on Render (*.onrender.com).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://*.onrender.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
